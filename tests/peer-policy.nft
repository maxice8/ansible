# Disposable VM policy: limit the probe user's loopback connections to TCP 18081.
# Own this table only. Non-loopback denials remain the cgroup-BPF test's job.
destroy table inet homelab_probe_test
table inet homelab_probe_test {
  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid 62000 ct state established,related accept
    meta skuid 62000 ip daddr 127.0.0.0/8 tcp dport 18081 accept
    meta skuid 62000 ip6 daddr ::1 tcp dport 18081 accept
    meta skuid 62000 ip daddr 127.0.0.0/8 reject
    meta skuid 62000 ip6 daddr ::1 reject
  }
}
