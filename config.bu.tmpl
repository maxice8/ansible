variant: fcos
version: 1.7.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "${SSH_PUB_KEY}"
storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: ${HOSTNAME}
        
    - path: /etc/NetworkManager/system-connections/public-network.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id=public-network
          type=ethernet
          
          [ethernet]
          mac-address=${MAC_ADDRESS}
          
          [ipv4]
          address1=${IPV4_ADDRESS},${IPV4_GATEWAY}
          dns=8.8.8.8;1.1.1.1;
          method=manual
          
          [ipv6]
          address1=${IPV6_ADDRESS},${IPV6_GATEWAY}
          dns=2001:4860:4860::8888;2001:4860:4860::8844;
          method=manual

    - path: /etc/yum.repos.d/netbird.repo
      mode: 0644
      contents:
        inline: |
          [netbird]
          name=netbird
          baseurl=https://pkgs.netbird.io/yum/
          enabled=1
          gpgcheck=1
          gpgkey=https://pkgs.netbird.io/yum/repodata/repomd.xml.key
          repo_gpgcheck=1

    - path: /etc/systemd/system-preset/10-homelab.preset
      mode: 0644
      contents:
        inline: |
          enable cockpit.socket
          enable netbird.service
systemd:
  units:
    - name: serial-getty@ttyS0.service
      enabled: true
    - name: layer-system-packages.service
      enabled: true
      contents: |
        [Unit]
        Description=Layer system packages live via rpm-ostree
        Wants=network-online.target
        After=network-online.target
        ConditionPathExists=!/var/lib/pkgs-layered

        [Service]
        Type=oneshot
        RemainAfterExit=yes

        # Added ostree, selinux, networkmanager, and storaged plugins
        ExecStart=/usr/bin/rpm-ostree install -y --idempotent --allow-inactive \
          python3 netbird \
          cockpit-ws cockpit-system cockpit-podman \
          cockpit-ostree cockpit-selinux cockpit-networkmanager cockpit-storaged cockpit-files

        ExecStart=/usr/bin/touch /var/lib/pkgs-layered
        ExecStart=/usr/bin/systemctl reboot

        [Install]
        WantedBy=multi-user.target
kernel_arguments:
  should_exist:
    - console=tty0
    - console=ttyS0,115200n8
