# UID 5010: client replies and TCP DNS to the configured forwarders only.
destroy table inet unbound_egress
table inet unbound_egress {
  chain output {
    type filter hook output priority filter; policy accept;
    meta skuid 5010 ct state established,related accept
    meta skuid 5010 ip daddr { 9.9.9.9, 8.8.8.8, 208.67.222.222 } tcp dport 53 accept
    meta skuid 5010 reject
  }
}
